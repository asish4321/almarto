# ==========================================
# ALMARTO E-COMMERCE ENVIRONMENT CONFIGURATION
# ==========================================

# Supabase PostgreSQL Connection (Transaction Pooler for queries)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct / Session Pooler Connection for Prisma schema migrations & push
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# Supabase API Credentials
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR_SUPABASE_ANON_KEY]"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[YOUR_SUPABASE_PUBLISHABLE_KEY]"

# Authentication & Security Secrets
JWT_SECRET="your-jwt-secret-key-at-least-32-characters"
ADMIN_SECRET_KEY="your-admin-secret-key"

# Email / SMTP Configuration (Optional, for direct order / OTP delivery)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"
SMTP_FROM="ALMARTO <noreply@almarto.com>"
